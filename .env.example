TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GEMINI_API_KEY=
# PROVIDER=gemini          # gemini | anthropic (then set ANTHROPIC_API_KEY)
# GEMINI_MODEL=gemini-2.5-flash
# CHUNK_MINUTES=45
# WHISPER_MODEL=large-v3-turbo
# MONITOR=1

# ---- Server (Linux) only ----
# TEAMS_BACKEND=web            # set by lecture-bot.service; app = Teams desktop app on Windows
# TEAMS_GUEST_NAME=George (notes)   # name shown in the meeting when joining as a guest
# TEAMS_STORAGE_STATE=teams-state.json  # saved login from teams_login.py (optional)
# BROWSER_HEADLESS=0           # 1 = no Xvfb; Teams may refuse headless Chromium
# OMNIROUTE_URL=               # leave empty on the server: OmniRoute runs on the PC

# Server: automatic Teams sign-in when Microsoft asks for the password again.
# Set them with: bash deploy/set_teams_password.sh (never commit real values)
TEAMS_EMAIL=
TEAMS_PASSWORD=
